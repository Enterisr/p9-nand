// Utility class with helper functions
class Helpers{

    // Calculates X coordinate from memory location
    function int getXFromMemoryLoc(int memoryLoc){
        var int screenOffset;
        var int x;
        let screenOffset = memoryLoc - 16544;
        let x = Helpers.mod32(screenOffset);
        return x;
    }   
    
    // Calculates Y coordinate from memory location
    function int getYFromMemoryLoc(int memoryLoc){
        var int screenOffset;
        var int y;
        let screenOffset = memoryLoc - 16544;
        let y = Math.divide(screenOffset,32);
        return y;
    }  
    // function int coordsToMemLocation(int x,int y){
    //     var int rowOffset,startRowLoc;
    //     var int colOffset,startRowLoc;
    //     let rowOffset = Math.multiply(x,32);
    //     let colOffset = 
    // }   
    // Checks if two objects are close enough to be considered colliding
    // Returns true if objects are within proximity thresholds
    function boolean checkProximity(int obj1LocOnMemory,int obj2LocOnMemory, int sensativityX,int sensativityY){
        //trying to simulate hitboxes
        var int x1,x2,y1,y2, diffX,diffY, diffXAbs, diffYAbs;
        var boolean isHitX,isHitY,isHit;        
        let x1  = Helpers.getXFromMemoryLoc(obj1LocOnMemory);
        let x2 =  Helpers.getXFromMemoryLoc(obj2LocOnMemory);

        let y1  =  Helpers.getYFromMemoryLoc(obj1LocOnMemory);
        let y2 =  Helpers.getYFromMemoryLoc(obj2LocOnMemory);
        let diffX = x1-x2;
        let diffY = y1-y2;
        let diffXAbs = Math.abs(diffX);
        let diffYAbs = Math.abs(diffY); 
        let isHitX =  diffXAbs<sensativityX;
        let isHitY =  diffYAbs<sensativityY;
        if(sensativityX=1000){
            // do Output.moveCursor(17,21);
            // do Output.printInt(diffXAbs);
            // do Output.printString("---");
            // do Output.printInt(diffYAbs);
            // do Output.printString(";");
            
            // do Output.moveCursor(20,25);
            // do Output.printInt(obj1LocOnMemory);
            // do Output.printString("---");
            // do Output.printInt(obj2LocOnMemory);
            // do Output.printString(";");
        }
        // do Output.printInt(diffXAbs);
        // do Output.printString("---");
        // do Output.printInt(diffYAbs);
        // do Output.printString(";");
        let isHit =isHitX & isHitY;
        return isHit;
    }   
    
    // Calculates modulo 32 of a number (bitwise method)
    function int mod32(int num){
      var int mo;
      // 0 0 0... 0 0 1 1 1
      let mo = 32-1;
      return mo & num;
    }

    // Safe wrapper for Memory.poke that prevents out-of-bounds access
    function void safeScreenPoke(int addr,int val){
      if(addr>16384 )
      {
         if(addr<24605){
            do Memory.poke(addr,val);
         }
      }
      return;
   }
}