// Main game controller class
class RikoGame {
   field Riko riko;           // Player character
   field int direction;       // Current movement direction: 0=none, 1=up, 2=down
   field Array bullets;       // Array of active bullets
   field int bulletCount;     // Number of bullets currently active
   field EnemyHandler enemyHandler; // Enemy management object
   field int score;           // Player's current score
   static int animationDelayCycles; // Game animation delay
   field int currentDelayCycle;     // Current animation cycle counter
   field int baseLocation;    // Location of player base (bottom of screen)
   field int maxBullets;      // Maximum bullets allowed at once
   field int level;           // Current game level
   
   /** Constructs a new game instance */
   constructor RikoGame new() {
      let enemyHandler = EnemyHandler.new();
      let riko = Riko.new();
      let baseLocation = 23934;
      let level = 3;
      let maxBullets = 1;
      let bullets = Array.new(maxBullets);
      let direction = 0; 
      let bulletCount = 0;    
      let score = 0; 
      do Output.moveCursor(1,1);
      do Output.printString("Score: ");
      do Output.moveCursor(1,10);
      do Output.printInt(score);
      let animationDelayCycles =3000;
      let currentDelayCycle = 0;
      return this;
   }
   
   // Displays game over screen and ends the game
   method void handleGameover(){
      
      do Output.moveCursor(10,10);
      do Output.printString("GAME OVER");
      do Sys.wait(3000);
      do dispose();
      return;
   }
   
   // Increases and displays the updated score
   method void updateScore(){
      
      let score = score+1;
      do Output.moveCursor(1,10);
      do Output.printInt(score);
      return;
   }
   
   // Removes all bullets and frees memory
   method void disposeBullets(){
      var int i;
      var Bullet bTemp;
      let bTemp =  bullets[i];
      while(bulletCount>i ){
        let bTemp =  bullets[i];
        do bTemp.dispose();
        let i = i+1;
      }
      do bullets.dispose();
      let bulletCount = 0;
      return;
   }
   
   /** Frees all game resources */
   method void dispose() {
      do riko.dispose();
      do enemyHandler.dispose();
      do disposeBullets();
      do Memory.deAlloc(this);
      return;
   }

   /** Moves the player based on current direction */
   method void moveRiko() {
      if (direction = 3) { do riko.moveLeft(); }
      if (direction = 4) { do riko.moveRight(); }
      return;
   }
   
   // Removes a bullet at specified index
   method void removeBullet(int idx){
      var int i;
      var Bullet bTemp;
      let bTemp =  bullets[i];
      do bTemp.delete();
      let i = idx+1;
      let bulletCount = bulletCount -1;
      while(bulletCount>i ){
        let bTemp =  bullets[i];
        let bullets[i-1] = bTemp;
        let i = i+1;
      }
      return;
   }
   
   // Creates a new bullet at player's position
   method void spawnBullet(int playerLoc) {
      var Bullet b;
      if(bulletCount<maxBullets)
      {   
         let b = Bullet.new(playerLoc);
         let bullets[bulletCount] = b;
         let bulletCount=bulletCount+1;

      }
      return;
   }

   // Updates and draws all active bullets
   // Returns true if redraw needed (bullet hit enemy)
   method boolean drawBullets(){
      var Bullet b;
      var int i;
      var boolean isBulletHit;
      var int res;
      let i=0;
      while(i<bulletCount){
         let b = bullets[i];
         let res =  b.move();
         if(~res){
            do removeBullet(i);
         }
         else{
            let isBulletHit =  enemyHandler.handleBulletHitInEnemy(b.getScreenLoc());
                  if(isBulletHit){                        
                        do updateScore();
                        do removeBullet(i);
                        return true; //trigger redraw 
               }
         }
            let i=i+1;
      }
      return false;
   }

   // Draws the player base at bottom of screen
   method void drawBase(){


      //256 lines, each line have 32 words, each word have 16 bit
      //line takes 32 memory.poke
      //last word is in 
      var int wordIndex;
      var int memAddress;
      var int i;
      let i = 0;
      // 24574 - 640; SCREENSIZE - OFFSET TO DRAW+SPACE
      let memAddress = baseLocation;
      while(i<224)
      {
         do Memory.poke(memAddress + i, -1);
         let i=i+1;
      }
      return;
   }
   
   // Main rendering method for the game scene
   // Returns 1 if game over, 0 otherwise
   method int drawScene(){
      var boolean redraw;
      var int gameStatus;
      if(currentDelayCycle=animationDelayCycles)
      {
         let gameStatus = enemyHandler.drawEnemies(baseLocation);
         if(gameStatus=1){
            return 1;
         }
         let redraw= drawBullets();
         if(redraw){
            do drawScene();
         }

         return 0;
         }
      else
      {
         let currentDelayCycle = currentDelayCycle+1;
         return 0;
      }  
   }
   
   // Increases level and difficulty when all enemies defeated
   method void levelUp(){
      var int speedInc;
      if(enemyHandler.getEnemiesCount()=0){
         let level=level+1;
         let speedInc = Math.multiply(level,5);
         do enemyHandler.spawnEnemies(level);
         do enemyHandler.setDelay(speedInc);
      }
      
      return;
   }

   /** Main game loop - handles input and updates game state */
   method void run() {
      var char key;  // the key currently pressed by the user
      var boolean exit;
      var boolean toShoot;
      let exit = false;
      let toShoot = false;
      do enemyHandler.spawnEnemies(level);
      do drawBase();
      do riko.draw();
      while (~exit) {

         while (key = 0) {         
            let exit =  drawScene()=1; 
            if(exit){
               do handleGameover();
               return;
            }
            let key = Keyboard.keyPressed();
            let direction = 0;
            let toShoot = false;
            do levelUp();
         }
         if (key = 81)  { let exit = true; }     // q key
         if (key = 130) { let direction = 3; }   // left arrow
         if (key = 132) { let direction = 4; }   // right arrow
         if (key = 32)  { let toShoot = true; } //shoot

         while (~(key = 0)) {
            let exit =  drawScene()=1; 
            if(exit){
               do handleGameover();
               return;
            }
            let key = Keyboard.keyPressed();
            do moveRiko();
            if(toShoot){
               let toShoot = false;
               do spawnBullet(riko.getMemLoc());
               
            } 
            do levelUp();
         }
     } // while
     return;
   }
}



