
class RikoGame {
   field Riko riko; 
   field int direction; // the riko's current direction: 
                        // 0=none, 1=up, 2=down
   field Array bullets;
   field int bulletCount;
   field EnemyHandler enemyHandler;
   


   /** Constructs a new Riko Game. */
   constructor RikoGame new() {
      let enemyHandler = EnemyHandler.new();
      let riko = Riko.new(22934);
      let bullets = Array.new(5);
      let direction = 0; 
      let bulletCount = 0;     
      return this;
   }

   /** Disposes this game. */
   method void dispose() {
      do riko.dispose();
      do Memory.deAlloc(this);
      return;
   }

   /** Moves the riko in the current direction. */
   method void moveRiko() {
      if (direction = 3) { do riko.moveLeft(); }
      if (direction = 4) { do riko.moveRight(); }
      return;
   }
   method void removeBullet(int idx){
      var int i;
      var Bullet bTemp;
      let bTemp =  bullets[i];
      do bTemp.delete();
      let i = idx+1;

      while(bulletCount>i ){
        let bTemp =  bullets[i];
        let bullets[i-1] = bTemp;
        let i = i+1;
      }
      return;
   }
   method void spawnBullet(int playerLoc) {
      var Bullet b;
      if(bulletCount<5)
      {   
         do Output.printString("spawn BULLET");
         do Output.printInt(playerLoc);
         let b = Bullet.new(playerLoc);
         let bullets[bulletCount] = b;
         let bulletCount=bulletCount+1;

      }
      return;
   }
   method void drawBullets(){
      var Bullet b;
      var int i;
      var int res;
      let i=0;
      while(i<bulletCount){
         let b = bullets[i];
         let res =  b.move();
         if(~res){
            // do Output.printString("removing bullet!");
            do removeBullet(i);
            let bulletCount = bulletCount -1;
         }
         let i=i+1;
      }
      return;
   }

   method void drawBase(){


      //256 lines, each line have 32 words, each word have 16 bit
      //line takes 32 memory.poke
      //last word is in 
      var int wordIndex;
      var int memAddress;
      var int i;
      let i = 0;
      // 24574 - 640; SCREENSIZE - OFFSET TO DRAW+SPACE
      let memAddress = 23934;
      while(i<224)
      {
         do Memory.poke(memAddress + i, -1);
         let i=i+1;
      }
      return;
   }
   
   method void drawScene(){
      do enemyHandler.drawEnemies();
      do drawBullets();
      return;
   }

   /** Runs the game: handles the user's inputs and moves the riko accordingly */
   method void run() {
      var char key;  // the key currently pressed by the user
      var boolean exit;
      var boolean toShoot;
      let exit = false;
      let toShoot = false;
      do enemyHandler.spawnEnemies(1);
      do drawBase();
      do riko.draw();
     // do Output.printInt(riko.getMemLoc());
      while (~exit) {

         while (key = 0) {         
            do drawScene();
            let key = Keyboard.keyPressed();
            let direction = 0;
            let toShoot = false;
         }
         if (key = 81)  { let exit = true; }     // q key
         if (key = 130) { let direction = 3; }   // left arrow
         if (key = 132) { let direction = 4; }   // right arrow
         if (key = 32)  { let toShoot = true; } //shoot

         while (~(key = 0)) {
            do drawScene();
            let key = Keyboard.keyPressed();
            do moveRiko();
            if(toShoot){
               let toShoot = false;
               do spawnBullet(riko.getMemLoc());
            } 
         }
     } // while
     return;
   }
}



