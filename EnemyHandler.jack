// Class that manages multiple enemy instances
class EnemyHandler {


   field Array enemies;           // Array of enemy objects
   field int enemiesCount;        // Number of enemies currently active
   field int startScreenLoc;      // Starting memory location for enemies
   static int MAX_ENEMIES;        // Maximum number of enemies allowed
   field boolean movedDownLastTime; // Tracks if enemies moved down in last cycle
   field boolean movingDirection;   // Current movement direction (-1 left, 1 right)
   static int animationDelayCycles; // Delay between movements
   static int currentDelayCycle;    // Current cycle counter
   
   // Constructor - initializes the enemy handler
   constructor EnemyHandler new() {
      let startScreenLoc =17484;
      let MAX_ENEMIES = 20;
      let animationDelayCycles = 1000;
      let currentDelayCycle = 0;
      let movedDownLastTime = false;
      let enemiesCount = 0; 
      let movingDirection = -1;
      let enemies = Array.new(MAX_ENEMIES);
      return this;
   }
    
   // Returns current enemy count
   method int getEnemiesCount() {
        return enemiesCount;
   }
   
   // Reduces the animation delay to speed up enemies
   method void setDelay(int removeFromDelay) {
        let animationDelayCycles =animationDelayCycles - removeFromDelay;
        return;
   }

   // Frees handler memory
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }
   
   // Removes enemy at specified index
   method void removeEnemy(int idx){
      var int i;
      var Enemy bTemp;
      let bTemp =  enemies[i];
      do bTemp.delete();
      let i = idx+1;

      while(enemiesCount>i ){
        let bTemp =  enemies[i];
        let enemies[i-1] = bTemp;
        let i = i+1;
      }
      let enemiesCount = enemiesCount - 1;
      return;
   }
   
   // Creates specified number of new enemies
   method void spawnEnemies(int num){
        var int i;
        var int memLocationShift;
        var int finalMemLoc;
        var int reqSize;
        var Enemy enemyIt;
        let i = 0;
        let reqSize = enemiesCount + num;
        let finalMemLoc = startScreenLoc;
        
        if(reqSize>MAX_ENEMIES){
            return;
        }
        
        let enemiesCount = enemiesCount  +num;
        while(i<num){
            
            let finalMemLoc = finalMemLoc +3 ;
            let enemyIt = Enemy.new(finalMemLoc); 
            do enemyIt.draw();
            let enemies[i] = enemyIt;
            let i=i+1;
        }

        return;
    }
    
    // Checks if bullet hit any enemy
    // Returns true if hit detected
    method boolean handleBulletHitInEnemy(int bulletMemLoc){
        var Enemy enemyIt;
        var boolean isClose;
        var int i;             
        while(i<enemiesCount){
            let enemyIt = enemies[i]; 
            let isClose = Helpers.checkProximity(bulletMemLoc,enemyIt.getScreenLoc(),3,10);
            if(isClose){
                do removeEnemy(i);
                return true;
            }
            let i=i+1;
        }
        return false;
    }

   // Updates and draws all enemies
   // Returns 1 if game over (reached base)
   method int drawEnemies(int baseLocation){
        var boolean isEndLeft,isEndRight,isEnd,isTouchBase;
        var int firstX,lastX,y ,i,lastIdx,previousDirction;
        var Enemy firstEnemy,lastEnemy,enemyIt;
      if(currentDelayCycle=animationDelayCycles){
        let currentDelayCycle = 0;
        let i = 0;
        let lastIdx = enemiesCount-1;
        let firstEnemy = enemies[0];
        let lastEnemy = enemies[lastIdx];
        let firstX = Helpers.getXFromMemoryLoc(firstEnemy.getScreenLoc());
        let lastX = Helpers.getXFromMemoryLoc(lastEnemy.getScreenLoc());
        let isTouchBase = Helpers.checkProximity(baseLocation,firstEnemy.getScreenLoc(),1000,20);
        let isEndRight = lastX>30;
        let isEndLeft = firstX<1;

        do Output.moveCursor(15,20);
 
        
        let isEnd = isEndRight|isEndLeft;

        
        let previousDirction = movingDirection;
        if(isTouchBase){
            return 1; //game over
        }
        
        if(isEnd){
            if(~movedDownLastTime){

                let movedDownLastTime =true;
                let movingDirection = 0;
            }
        }
        else{
            let movedDownLastTime =false; 
            if(isEndRight){

                let movingDirection = -1;
            }
            if(isEndLeft){

                let movingDirection = 1;
            }
        }
        
        while(i<enemiesCount){
            let enemyIt = enemies[i]; 
            do enemyIt.move(movingDirection);
            let i=i+1;
        }
        if (~movingDirection){
        //change direction
           let  movingDirection = Math.multiply(previousDirction,-1);
        }
        }
        else{
            let currentDelayCycle = currentDelayCycle+1;
        }
        return 0;
        }
    

   // Free all resources
   method void delete() {
      do dispose();
      return;
   }


}
