
class Bullet {

   field int x, y;
   field int size; 
   static int MOVEMENT;

   constructor Bullet new(int Ax, int Ay) {
      let x = Ax;
      let y = Ay;
      let size = 5;
      let MOVEMENT = 2; 
      do draw();
      return this;
   }


   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   method void draw() {
      do Screen.setColor(true);
      do Screen.drawRectangle(x, y, x + size, y + size);
      return;
   }

   method void delete() {
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + size, y + size);
      do dispose();
      return;
   }

   method int getX(){
      return x;
   }
   method int getY(){
      return y;
   }

   method int move() {
      if (y > 1) {
         do Screen.setColor(false);
         do Screen.drawRectangle(x, (y + size) - 1, x + size, y + size);
         let y = y - 2;
         do Screen.setColor(true);
         do Screen.drawRectangle(x, y, x + size, y + 1);
         do Sys.wait(1);  
         return 1;
      }
      return 0;
     
   }
}