
class Bullet {

   field int screenLoc;
   static int LENGTH; 
   static int MOVEMENT;
   static int animationDelayCycles;
   field int currentDelayCycle;
   constructor Bullet new() {
      let screenLoc = -1;
      let MOVEMENT = 2;
      let LENGTH = 10;
      let animationDelayCycles = 100;
      let currentDelayCycle = 0;
      do draw();
      return this;
   }


   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   method void draw() {
      var int line, i, memAddress; 
      let memAddress = 16384+screenLoc;
      let i = 0;
      while(i<LENGTH){
         let line =Math.multiply(32,i);
         do  Helpers.safeScreenPoke(memAddress +line, 124);
         let i=i+1;
      }
      // // column 0
      // // column 1
      // do Memory.poke(memAddress +1, 124);
      // do Memory.poke(memAddress +33, 124);
      // do Memory.poke(memAddress +65, 124);
      // do Memory.poke(memAddress +97, 124);
      // do Memory.poke(memAddress +129, 124);
      // do Memory.poke(memAddress +161, 124);
      // do Memory.poke(memAddress +193, 124);
      // do Memory.poke(memAddress +225, 124);
      // do Memory.poke(memAddress +257, 124);
      // do Memory.poke(memAddress +289, 124);
      // do Memory.poke(memAddress +321, 124);
      // do Memory.poke(memAddress +353, 124);
      return;
   }
   method void deleteSprite(){
      var int res,line, i, memAddress; 
      let memAddress = 16384+screenLoc;
      let i = 0;
      while(i<LENGTH){
         let line =Math.multiply(32,i);
         do Helpers.safeScreenPoke(memAddress +line, 0);
         let i=i+1;
      }
      return;
   }

   method void delete() {
      do deleteSprite();
      do dispose();
      return;
   }



   method int move() {
      if(currentDelayCycle=animationDelayCycles){
         let currentDelayCycle = 0;
         let screenLoc = screenLoc+32;
         return 1;
      }
      else{
         let currentDelayCycle = currentDelayCycle+1;
         return 1;
      }  

      return 0;
     
   }
}
