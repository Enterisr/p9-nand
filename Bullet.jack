// Class representing a bullet fired by the player
class Bullet {

   field int screenLoc;        // Screen memory address location
   static int LENGTH;          // Visual length of bullet
   static int MOVEMENT;        // Movement speed (in memory units)
   static int animationDelayCycles; // Cycles between movements
   field int currentDelayCycle;     // Current cycle counter
   
   // Constructor - creates a new bullet based on player position
   constructor Bullet new(int playerMemLoc) {
      let screenLoc = playerMemLoc-320;
      let MOVEMENT =256;
      let LENGTH = 10;
      let animationDelayCycles =100;
      let currentDelayCycle = 0;
      do draw();
      return this;
   }


   // Returns the screen memory location
   method int getScreenLoc() {
      return screenLoc;
   }
   
   // Frees memory allocated to the bullet
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   // Draws the bullet on screen
   method void draw() {
      var int line, i, memAddress; 
      let memAddress =screenLoc;
      let i = 0;
      while(i<LENGTH){
         let line =Math.multiply(32,i);
         do  Helpers.safeScreenPoke(memAddress +line, 124);
         let i=i+1;
      }
      return;
   }
   
   // Erases the bullet from screen
   method void deleteSprite(){
      var int line, i, memAddress; 
      let memAddress = screenLoc;
      let i = 0;
      while(i<LENGTH){
         let line =Math.multiply(32,i);
         do Helpers.safeScreenPoke(memAddress +line, 0);
         let i=i+1;
      }
      return;
   }

   // Removes the bullet entirely (erase + dispose)
   method void delete() {
      do deleteSprite();
      do dispose();
      return;
   }


   // Moves the bullet forward after delay cycles
   // Returns 1 if bullet is still active, 0 otherwise
   method int move() {
      
      if(currentDelayCycle=animationDelayCycles){
         do deleteSprite();
         let currentDelayCycle = 0;
         let screenLoc = screenLoc-MOVEMENT;
         if(screenLoc<16000){
            return 0;
         }
         do draw();
         return 1;
      }
      else{
         let currentDelayCycle = currentDelayCycle+1;
         return 1;
      }  

      return 0;
     
   }
}
