// Class representing an enemy character
class Enemy {

   field int screenLoc;    // Screen memory location
   static int MOVEMENT;    // Movement speed

   // Constructor - creates enemy at specified location
   constructor Enemy new(int loc) {
      let screenLoc =loc;
      let MOVEMENT = 1; 

      return this;
   }


   // Frees memory allocated to enemy
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }
   
   // Erases enemy sprite from screen
   method void deleteSprite(){
      var int memAddress;
         let memAddress = screenLoc;
         do Helpers.safeScreenPoke(memAddress, 0);
         do Helpers.safeScreenPoke(memAddress +32, 0);
         do Helpers.safeScreenPoke(memAddress +64, 0);
         do Helpers.safeScreenPoke(memAddress +96, 0);
         do Helpers.safeScreenPoke(memAddress +128, 0);
         do Helpers.safeScreenPoke(memAddress +160, 0);
         do Helpers.safeScreenPoke(memAddress +192, 0);
         do Helpers.safeScreenPoke(memAddress +224, 0);
         do Helpers.safeScreenPoke(memAddress +256, 0);
         do Helpers.safeScreenPoke(memAddress +288, 0);
         do Helpers.safeScreenPoke(memAddress +320, 0);
         do Helpers.safeScreenPoke(memAddress +352, 0);
         do Helpers.safeScreenPoke(memAddress +384, 0);
         do Helpers.safeScreenPoke(memAddress +416, 0);
         do Helpers.safeScreenPoke(memAddress +448, 0);
         do Helpers.safeScreenPoke(memAddress +480, 0);
         do Helpers.safeScreenPoke(memAddress +512, 0);
         do Helpers.safeScreenPoke(memAddress +544, 0);
         do Helpers.safeScreenPoke(memAddress +576, 0);
         // column 1
         do Helpers.safeScreenPoke(memAddress +1, 0);
         do Helpers.safeScreenPoke(memAddress +33, 0);
         do Helpers.safeScreenPoke(memAddress +65, 0);
         do Helpers.safeScreenPoke(memAddress +97, 0);
         do Helpers.safeScreenPoke(memAddress +129, 0);
         do Helpers.safeScreenPoke(memAddress +161, 0);
         do Helpers.safeScreenPoke(memAddress +193, 0);
         do Helpers.safeScreenPoke(memAddress +225, 0);
         do Helpers.safeScreenPoke(memAddress +257, 0);
         do Helpers.safeScreenPoke(memAddress +289, 0);
         do Helpers.safeScreenPoke(memAddress +321, 0);
         do Helpers.safeScreenPoke(memAddress +353, 0);
         do Helpers.safeScreenPoke(memAddress +385, 0);
         do Helpers.safeScreenPoke(memAddress +417, 0);
         do Helpers.safeScreenPoke(memAddress +449, 0);
         do Helpers.safeScreenPoke(memAddress +481, 0);
      return 0;
   }


   // Draws enemy sprite at current position
   method void draw() {
      var int memAddress;
      let memAddress =screenLoc;
      do Helpers.safeScreenPoke(memAddress, -32738);
      do Helpers.safeScreenPoke(memAddress +32, -16334);
      do Helpers.safeScreenPoke(memAddress +64, 16418);
      do Helpers.safeScreenPoke(memAddress +96, 32742);
      do Helpers.safeScreenPoke(memAddress +128, 1);
      do Helpers.safeScreenPoke(memAddress +160, -32747);
      do Helpers.safeScreenPoke(memAddress +192, -32739);
      do Helpers.safeScreenPoke(memAddress +224, 1);
      do Helpers.safeScreenPoke(memAddress +256, 8161);
      do Helpers.safeScreenPoke(memAddress +288, 8161);
      do Helpers.safeScreenPoke(memAddress +320, 1);
      do Helpers.safeScreenPoke(memAddress +352, 1);
      do Helpers.safeScreenPoke(memAddress +384, 4353);
      do Helpers.safeScreenPoke(memAddress +416, 3587);
      do Helpers.safeScreenPoke(memAddress +448, 4356);
      do Helpers.safeScreenPoke(memAddress +480, -32740);
      do Helpers.safeScreenPoke(memAddress +512, 16416);
      do Helpers.safeScreenPoke(memAddress +544, 20256);
      do Helpers.safeScreenPoke(memAddress +576, 28896);
      // column 1
      do Helpers.safeScreenPoke(memAddress +1, 7);
      do Helpers.safeScreenPoke(memAddress +33, 4);
      do Helpers.safeScreenPoke(memAddress +65, 4);
      do Helpers.safeScreenPoke(memAddress +97, 6);
      do Helpers.safeScreenPoke(memAddress +129, 8);
      do Helpers.safeScreenPoke(memAddress +161, 10);
      do Helpers.safeScreenPoke(memAddress +193, 11);
      do Helpers.safeScreenPoke(memAddress +225, 8);
      do Helpers.safeScreenPoke(memAddress +257, 8);
      do Helpers.safeScreenPoke(memAddress +289, 8);
      do Helpers.safeScreenPoke(memAddress +321, 8);
      do Helpers.safeScreenPoke(memAddress +353, 8);
      do Helpers.safeScreenPoke(memAddress +385, 8);
      do Helpers.safeScreenPoke(memAddress +417, 12);
      do Helpers.safeScreenPoke(memAddress +449, 2);
      do Helpers.safeScreenPoke(memAddress +481, 3);

      return;
   }

   // Completely removes enemy (erase + dispose)
   method void delete() {
      do deleteSprite();
      do dispose();
      return;
   }
   
   // Returns the current screen memory location
   method void getScreenLoc() {
      
      return screenLoc;
   }


   // Moves enemy based on direction parameter
   // 1 = right, -1 = left, 0 = down
   // Returns 1 to indicate successful movement
   method int move(int direction) {
         var int memAddress,mod32res,x,y;
         do deleteSprite(); 
         if(direction=1){
             let screenLoc = screenLoc +MOVEMENT;//RIGHT
         }
         if(direction=-1){
             let screenLoc = screenLoc -MOVEMENT;//LEFT
         }
         if(direction = 0){
            let screenLoc = screenLoc+160;
            
         }
         do draw();
         return 1;
      

      return 0;
     
   }
}
