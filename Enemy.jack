
class Enemy {

   field int screenLoc;
   field int size; 
   static int MOVEMENT;
   static int numOfEnemies;
   field Array enemies;
   field int enemiesCount;
   constructor Enemy new(int _screenLoc) {
      let screenLoc =_screenLoc;
      let MOVEMENT = 2; 
      do draw();
      return this;
   }



   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

    function void spawnEnemies(int number){
        let numOfEnemies = numOfEnemies  +number;
        
        
    }

   method void draw() {
      do Screen.setColor(true);
      let memAddress = 16384+screenLoc;
      // column 0
      do Memory.poke(memAddress, -32738);
      do Memory.poke(memAddress +32, -16334);
      do Memory.poke(memAddress +64, 16418);
      do Memory.poke(memAddress +96, 32742);
      do Memory.poke(memAddress +128, 1);
      do Memory.poke(memAddress +160, -32747);
      do Memory.poke(memAddress +192, -32739);
      do Memory.poke(memAddress +224, 1);
      do Memory.poke(memAddress +256, 8161);
      do Memory.poke(memAddress +288, 8161);
      do Memory.poke(memAddress +320, 1);
      do Memory.poke(memAddress +352, 1);
      do Memory.poke(memAddress +384, 4353);
      do Memory.poke(memAddress +416, 3587);
      do Memory.poke(memAddress +448, 4356);
      do Memory.poke(memAddress +480, -32740);
      do Memory.poke(memAddress +512, 16416);
      do Memory.poke(memAddress +544, 20256);
      do Memory.poke(memAddress +576, 28896);
      do Memory.poke(memAddress +608, 0);
      do Memory.poke(memAddress +640, 0);
      do Memory.poke(memAddress +672, 0);
      do Memory.poke(memAddress +704, 0);
      do Memory.poke(memAddress +736, 0);
      do Memory.poke(memAddress +768, 0);
      do Memory.poke(memAddress +800, 0);
      // column 1
      do Memory.poke(memAddress +1, 7);
      do Memory.poke(memAddress +33, 4);
      do Memory.poke(memAddress +65, 4);
      do Memory.poke(memAddress +97, 6);
      do Memory.poke(memAddress +129, 8);
      do Memory.poke(memAddress +161, 10);
      do Memory.poke(memAddress +193, 11);
      do Memory.poke(memAddress +225, 8);
      do Memory.poke(memAddress +257, 8);
      do Memory.poke(memAddress +289, 8);
      do Memory.poke(memAddress +321, 8);
      do Memory.poke(memAddress +353, 8);
      do Memory.poke(memAddress +385, 8);
      do Memory.poke(memAddress +417, 12);
      do Memory.poke(memAddress +449, 2);
      do Memory.poke(memAddress +481, 3);
      do Memory.poke(memAddress +513, 0);
      do Memory.poke(memAddress +545, 0);
      do Memory.poke(memAddress +577, 0);
      do Memory.poke(memAddress +609, 0);
      do Memory.poke(memAddress +641, 0);
      do Memory.poke(memAddress +673, 0);
      do Memory.poke(memAddress +705, 0);
      return;
   }

   method void delete() {
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + size, y + size);
      do dispose();
      return;
   }

   method int getX(){
      return x;
   }
   method int getY(){
      return y;
   }

   method int move() {
      var int line;
      let line = Math.divide(screenLoc,32);
      if (line>10) { //player
         screenLoc = screenLoc +20;
         do Sys.wait(1);  
         return 1;
      }
      return 0;
     
   }
}
