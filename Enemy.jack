      do Helpers.safeScreenPoke(memAddress +353, 8);
      do Helpers.safeScreenPoke(memAddress +385, 8);
      do Helpers.safeScreenPoke(memAddress +417, 12);
      do Helpers.safeScreenPoke(memAddress +449, 2);
      do Helpers.safeScreenPoke(memAddress +481, 3);

      return;
   }

   method void delete() {
      do deleteSprite();
      do dispose();
      return;
   }
   method void getMemLoc() {
      return 
      return;
   }



   method int move(int direction) {
      var int memAddress,mod32res,x,y;

      if(currentDelayCycle=animationDelayCycles){
         let currentDelayCycle = 0;
         
         if(direction=1){
             let screenLoc = screenLoc +MOVEMENT;//RIGHT
         }
         if(direction=-1){
             let screenLoc = screenLoc -MOVEMENT;//LEFT
         }
         if(direction = 0){
            let screenLoc = screenLoc +32;
         }

         if(screenLoc>2934){
            do deleteSprite();
            do dispose();
            return 0;
         }
         do deleteSprite();
         do draw();
         return 1;
      }
      else{
         let currentDelayCycle = currentDelayCycle+1;
         return 1;
      }
      return 0;
     
   }
}
