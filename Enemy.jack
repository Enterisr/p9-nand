
class Enemy {

   field int screenLoc;
   field int size; 
   static int MOVEMENT;
   static int animationDelayCycles;
   static int currentDelayCycle;
   constructor Enemy new(int screenLoc) {
      let screenLoc =screenLoc;
      let MOVEMENT = 1; 
      let animationDelayCycles = 1000;
      let currentDelayCycle = 0;
      return this;
   }


   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }
   method void deleteSprite(){
      var int memAddress;
      let memAddress =  screenLoc;
      do Helpers.safeScreenPoke(memAddress, 0);
      do Helpers.safeScreenPoke(memAddress + 32, 0);
      do Helpers.safeScreenPoke(memAddress + 64, 0);
      do Helpers.safeScreenPoke(memAddress + 96, 0);
      do Helpers.safeScreenPoke(memAddress + 128, 0);
      do Helpers.safeScreenPoke(memAddress + 160, 0);
